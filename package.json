{
  "name": "asset-atlas",
  "version": "0.1.0",
  "description": "A visual, searchable, taggable browser for all Foundry assets",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
