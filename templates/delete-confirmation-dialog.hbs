<div class="delete-confirmation-dialog">
  <div class="warning-header">
    <i class="fas fa-exclamation-triangle"></i>
    <h3>Confirm Deletion</h3>
  </div>

  <div class="deletion-summary">
    <p>You are about to delete <strong>{{assetCount}}</strong> asset(s).</p>
    <p>Total size: <strong>{{formatBytes totalSize}}</strong></p>
  </div>

  {{#if hasUsedAssets}}
  <div class="warning-section">
    <h4><i class="fas fa-exclamation-circle"></i> Warning: Assets in Use</h4>
    <p>{{usedAssetCount}} of the selected assets are currently in use:</p>
    
    <div class="used-assets-list">
      {{#each usedAssets}}
      <div class="used-asset">
        <div class="asset-name">{{name}}</div>
        <div class="usage-info">
          Used in {{usage.count}} document(s):
          {{#if usage.scenes.length}}{{usage.scenes.length}} scene(s){{/if}}
          {{#if usage.journals.length}}{{usage.journals.length}} journal(s){{/if}}
          {{#if usage.actors.length}}{{usage.actors.length}} actor(s){{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    
    <p class="warning-text">
      <strong>Deleting these assets will break references in your documents!</strong>
    </p>
  </div>
  {{/if}}

  <div class="asset-list">
    <h4>Assets to be deleted:</h4>
    <ul>
      {{#each assets}}
      <li>
        <span class="asset-name">{{name}}</span>
        <span class="asset-size">({{formatBytes size}})</span>
        {{#if usage.count}}
        <span class="usage-badge" title="Used in {{usage.count}} places">
          <i class="fas fa-link"></i> {{usage.count}}
        </span>
        {{/if}}
      </li>
      {{/each}}
    </ul>
  </div>

  <div class="confirmation-checkbox">
    <label>
      <input type="checkbox" id="confirm-delete" />
      I understand that this action cannot be undone
    </label>
  </div>

  <div class="button-group">
    <button type="button" class="delete-button" disabled>
      <i class="fas fa-trash"></i> Delete Assets
    </button>
    <button type="button" class="cancel-button">
      <i class="fas fa-times"></i> Cancel
    </button>
  </div>
</div>
